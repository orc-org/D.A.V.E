# External repositories for the SLAM program (docs/slam/code-map.md).
# Candidates only: none of these has been built on the Orin Nano yet.
#
# They go in a SEPARATE overlay workspace so `colcon build` in ros2_ws is not affected:
#   mkdir -p slam_ws/src && vcs import slam_ws/src < scripts/slam/slam.repos
#   cd slam_ws && colcon build --symlink-install
#   source slam_ws/install/setup.bash   (after sourcing ros2_ws/install/setup.bash)
#
# `slam_ws/` is listed in .gitignore. Pin each `version:` to a commit once chosen.
repositories:
  # Official Unitree L2 SDK (C++, ROS 1 and ROS 2). ROS 2 package verified by the vendor
  # on Ubuntu 20.04 / Foxy only; expect to patch for Ubuntu 22.04 / Humble.
  unilidar_sdk2:
    type: git
    url: https://github.com/unitreerobotics/unilidar_sdk2.git
    version: main
  # Community standalone ROS 2 driver for the L2 (Jazzy, Ubuntu 24.04 target, GPL-3.0).
  l2lidar_node:
    type: git
    url: https://github.com/markgol/l2lidar_node.git
    version: main
  # LiDAR-inertial-visual odometry with a Gaussian map (HKUST). Needs CUDA; README says
  # tested on Jetson Orin NX 16 GB. Build status on JetPack 6.2 unknown.
  GS-LIVO:
    type: git
    url: https://github.com/HKUST-Aerial-Robotics/GS-LIVO.git
    version: main
  # GPU reconstruction and Nav2 costmap layer (needs the Isaac ROS toolchain/container).
  isaac_ros_nvblox:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nvblox.git
    version: main
