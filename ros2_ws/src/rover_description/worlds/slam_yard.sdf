<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <!-- physics configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- modern gazebo system plugins -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- sensors: renders the LiDAR and cameras (ogre2 needs OpenGL; under WSL2 this runs on the
         Mesa/WSLg driver) and simulates the IMU -->
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>

    <!-- sun light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
  
    <model name="wall_n">
      <static>true</static>
      <pose>0 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>16 0.3 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 0.3 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>16 0.3 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 0.3 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>8 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 12 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 12 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-8 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 12 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 12 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>3 2.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 1.0 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 1.0 1.2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_2">
      <static>true</static>
      <pose>-3.5 -2.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 2.0 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 2.0 0.9</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_mid">
      <static>true</static>
      <pose>-1 3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 3.0 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 3.0 1.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="drum_1">
      <static>true</static>
      <pose>4.5 -3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.7 0.4 0.3 1</ambient><diffuse>0.7 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="drum_2">
      <static>true</static>
      <pose>-5.5 3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.7 0.4 0.3 1</ambient><diffuse>0.7 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
