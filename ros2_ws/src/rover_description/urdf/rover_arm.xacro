<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- robotic arm modular component  -->

  <joint name="stand_column_joint" type="fixed">
    <parent link="base_link"/>
    <child link="column_link"/>
    <origin xyz="0 0 ${c_off}" rpy="0 0 0"/>
  </joint>

  <link name="column_link">
    <visual>
      <origin xyz="0 0 ${c_len/2.0}"/>
      <geometry>
        <cylinder radius="0.05" length="${c_len}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${c_len/2.0}"/>
      <geometry>
        <cylinder radius="0.05" length="${c_len}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="1.0" length="${c_len}" radius="0.05">
      <origin xyz="0 0 ${c_len/2.0}" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="stand_arm_joint" type="fixed">
    <parent link="column_link"/>
    <child link="mount_link"/>
    <origin xyz="0 0 ${c_len}" rpy="0 0 0"/>
  </joint>

  <link name="mount_link">
    <visual>
      <origin xyz="${m_len/2.0} 0 0"/>
      <geometry>
        <box size="${m_len} 0.05 0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="${m_len/2.0} 0 0"/>
      <geometry>
        <box size="${m_len} 0.05 0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.8" x="${m_len}" y="0.05" z="0.05">
      <origin xyz="${m_len/2.0} 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="arm_joint" type="continuous">
    <parent link="mount_link"/>
    <child link="actual_arm_link"/>
    <origin xyz="${m_len} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="actual_arm_link">
    <visual>
      <origin xyz="${a_len/2.0} 0 0"/>
      <geometry>
        <box size="${a_len} 0.04 0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${a_len/2.0} 0 0"/>
      <geometry>
        <box size="${a_len} 0.04 0.04"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="1.2" x="${a_len}" y="0.04" z="0.04">
      <origin xyz="${a_len/2.0} 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="actual_arm_link"/>
    <child link="tool_link"/>
    <origin xyz="${a_len} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool_link">
    <visual>
      <origin xyz="${t_len/2.0} 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${t_len/2.0} 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.3" radius="0.03">
      <origin xyz="${t_len/2.0} 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <!-- Gripper Fingers -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="tool_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.03 0.03 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.02" upper="0.04" effort="10" velocity="0.5"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry>
        <box size="0.06 0.01 0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0"/>
      <geometry>
        <box size="0.06 0.01 0.03"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.1" x="0.06" y="0.01" z="0.03">
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="tool_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.03 -0.03 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.02" upper="0.04" effort="10" velocity="0.5"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry>
        <box size="0.06 0.01 0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0"/>
      <geometry>
        <box size="0.06 0.01 0.03"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.1" x="0.06" y="0.01" z="0.03">
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="gripper_motor_body_joint" type="fixed">
    <parent link="tool_link"/>
    <child link="gripper_motor_body_link"/>
    <origin xyz="0.03 0 0.035" rpy="0 0 0"/>
  </joint>

  <link name="gripper_motor_body_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.15" x="0.03" y="0.03" z="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="gripper_motor_shaft_joint" type="continuous">
    <parent link="gripper_motor_body_link"/>
    <child link="gripper_motor_shaft_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="gripper_motor_shaft_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.08"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.08"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.05" length="0.08" radius="0.005">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
    </xacro:inertial_cylinder>
  </link>

</robot>
