<?xml version="1.0"?>
<!--
  Simulated perception sensors that follow the SLAM "sensor contract" (docs/slam/architecture.md):

    /lidar/points              sensor_msgs/PointCloud2   frame lidar_link
    /lidar/imu                 sensor_msgs/Imu           frame lidar_imu_link
    /camera/color/image        sensor_msgs/Image         frame camera_optical_frame
    /camera/color/camera_info  sensor_msgs/CameraInfo
    /camera/depth/image        sensor_msgs/Image (32FC1, metres)
    /camera/depth/camera_info  sensor_msgs/CameraInfo

  The LiDAR is modelled on the Unitree L2 (360 x 96 degrees, 30 m, about 64k points/s); the camera
  is a generic 640x480 depth camera, because the real camera is not chosen yet. Change the numbers
  in config/physical_params.yaml (section "sensors"), not here. All of this is a model of the sensors
  only: no noise model has been calibrated against real hardware.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="s" value="${xacro.load_yaml(config_path)['sensors']}" />

  <!-- LiDAR: mounted on top of the chassis -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${s['lidar_x']} ${s['lidar_y']} ${chassis_h + s['lidar_z']}" rpy="0 0 0"/>
  </joint>

  <!-- the L2's built-in IMU, a fixed offset from the LiDAR frame -->
  <link name="lidar_imu_link"/>
  <joint name="lidar_imu_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="lidar_imu_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- depth camera: front of the chassis, looking forward -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_l/2.0} 0 ${chassis_h + s['camera_z']}" rpy="0 0 0"/>
  </joint>

  <!-- optical frame convention: x right, y down, z forward -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>lidar</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <update_rate>${s['lidar_rate_hz']}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${s['lidar_h_samples']}</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>${s['lidar_v_samples']}</samples>
            <min_angle>${-s['lidar_v_fov_deg'] / 2.0 * pi / 180.0}</min_angle>
            <max_angle>${s['lidar_v_fov_deg'] / 2.0 * pi / 180.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>${s['lidar_max_range']}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${s['lidar_noise_std']}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_imu_link">
    <sensor name="lidar_imu" type="imu">
      <topic>lidar/imu</topic>
      <ignition_frame_id>lidar_imu_link</ignition_frame_id>
      <update_rate>${s['imu_rate_hz']}</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <!-- an rgbd_camera publishes colour, depth and camera_info under this topic prefix -->
      <topic>camera</topic>
      <ignition_frame_id>camera_optical_frame</ignition_frame_id>
      <update_rate>${s['camera_rate_hz']}</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>${s['camera_hfov_rad']}</horizontal_fov>
        <image>
          <width>${s['camera_width']}</width>
          <height>${s['camera_height']}</height>
        </image>
        <clip>
          <near>${s['camera_near']}</near>
          <far>${s['camera_far']}</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
