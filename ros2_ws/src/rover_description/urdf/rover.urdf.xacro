<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dave_rover">

  <!-- configuration and external parameters -->
  <xacro:property name="config_path" value="$(find rover_description)/config/physical_params.yaml" />
  <xacro:property name="params" value="${xacro.load_yaml(config_path)['robot_dimensions']}" />

  <!-- chassis dimensions -->
  <xacro:property name="chassis_l" value="${params['chassis_length']}" />
  <xacro:property name="chassis_w" value="${params['chassis_width']}" />
  <xacro:property name="chassis_h" value="${params['chassis_height']}" />
  <xacro:property name="chassis_m" value="${params['chassis_mass']}" />

  <!-- wheel dimensions -->
  <xacro:property name="wheel_r" value="${params['wheel_radius']}" />
  <xacro:property name="wheel_w" value="${params['wheel_width']}" />
  <xacro:property name="wheel_m" value="${params['wheel_mass']}" />
  <xacro:property name="wheel_x_off" value="${params['wheel_x_offset']}" />
  <xacro:property name="wheel_y_off" value="${params['wheel_y_offset']}" />
  <xacro:property name="wheel_z_off" value="${params['wheel_z_offset']}" />

  <!-- arm dimensions (available for rover_arm.xacro) -->
  <xacro:property name="c_off" value="${params['column_base_offset']}" />
  <xacro:property name="c_len" value="${params['column_height']}" />
  <xacro:property name="m_len" value="${params['mount_length']}" />
  <xacro:property name="a_len" value="${params['arm_length']}" />
  <xacro:property name="t_len" value="${params['tool_tip_length']}" />

  <!-- inertial macros and gazebo control plugins -->
  <xacro:include filename="inertial_macros.xacro" />
  <xacro:include filename="gazebo_control.xacro" />

  <!-- rviz materials -->
  <material name="chassis_orange"><color rgba="0.95 0.45 0.05 1.0"/></material>
  <material name="tire_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="rim_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="blue"><color rgba="0 0.4 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="green"><color rgba="0.1 0.8 0.1 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- base footprint (ground plane projection) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- position base_link above ground so wheels touch the surface -->
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <!-- base chassis (driving box) -->
  <link name="base_link">
    <!-- visual representation -->
    <visual>
      <origin xyz="0 0 ${chassis_h/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
      <material name="chassis_orange"/>
    </visual>

    <!-- collision geometry -->
    <collision>
      <origin xyz="0 0 ${chassis_h/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
    </collision>

    <!-- inertial properties for physics simulation -->
    <xacro:inertial_box mass="${chassis_m}" x="${chassis_l}" y="${chassis_w}" z="${chassis_h}">
      <origin xyz="0 0 ${chassis_h/2.0}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- 4-wheel macro definition -->
  <xacro:macro name="wheel" params="prefix x_offset y_offset">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_offset} ${y_offset} ${wheel_z_off}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <!-- visual wheel (cylinder aligned along y axis) -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>
        <material name="tire_black"/>
      </visual>

      <!-- collision wheel -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>
      </collision>

      <!-- wheel moment of inertia -->
      <xacro:inertial_wheel_y mass="${wheel_m}" length="${wheel_w}" radius="${wheel_r}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_wheel_y>
    </link>
  </xacro:macro>

  <!-- wheel instantiations -->
  <xacro:wheel prefix="front_left"  x_offset="${wheel_x_off}"  y_offset="${wheel_y_off}" />
  <xacro:wheel prefix="front_right" x_offset="${wheel_x_off}"  y_offset="-${wheel_y_off}" />
  <xacro:wheel prefix="rear_left"   x_offset="-${wheel_x_off}" y_offset="${wheel_y_off}" />
  <xacro:wheel prefix="rear_right"  x_offset="-${wheel_x_off}" y_offset="-${wheel_y_off}" />

  <!-- robotic arm and manipulator (modular component) -->
  <!-- to attach the robotic arm, simply uncomment the line below: -->
  <!-- <xacro:include filename="rover_arm.xacro" /> -->

</robot>
