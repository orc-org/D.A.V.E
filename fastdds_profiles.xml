<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastrtps_profile">
    <!-- Transport definitions for high-throughput wireless links & video -->
    <transport_descriptors>
        <!-- UDPv4 with 1MB socket buffers for long-range antenna links -->
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>1048576</receiveBufferSize>
            <maxMessageSize>65500</maxMessageSize>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="rover_network_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
            <builtin>
                <!-- Listen for discovery announcements on standard DDS multicast -->
                <metatrafficMulticastLocatorList>
                    <locator><udpv4><address>239.255.0.1</address></udpv4></locator>
                </metatrafficMulticastLocatorList>
                <!-- Send discovery announcements to local multicast and unicast antenna peers -->
                <initialPeersList>
                    <!-- Standard DDS multicast for local/switched network discovery (unlimited nodes) -->
                    <locator><udpv4><address>239.255.0.1</address></udpv4></locator>
                    <!-- Localhost for Jetson internal communication and local testing -->
                    <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
                    <!-- Unicast fallback for reliable long-range antenna communication -->
                    <locator><udpv4><address>192.168.1.87</address></udpv4></locator>
                    <locator><udpv4><address>192.168.1.88</address></udpv4></locator>
                </initialPeersList>
            </builtin>
        </rtps>
    </participant>
</profiles>
