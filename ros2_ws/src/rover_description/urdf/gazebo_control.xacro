<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- modern gazebo skid-steer drive -->
  <gazebo>
    <!-- diffdrive system plugin (supports multi-wheel pairs) -->
    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">

      <!-- left wheels -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <!-- right wheels -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- kinematics -->
      <wheel_separation>${wheel_y_off * 2.0}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>

      <!-- velocity and acceleration limits -->
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <min_linear_acceleration>-3.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <min_angular_velocity>-3.0</min_angular_velocity>

      <!-- topics (bridged to ros 2 by ros_gz_bridge) -->
      <topic>/cmd_vel_sim</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>50</odom_publisher_frequency>
    </plugin>

    <!-- joint state publisher for wheel rotations -->
    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- wheel friction and gazebo material settings -->
  <xacro:macro name="gazebo_wheel_props" params="link_name">
    <gazebo reference="${link_name}">
      <visual>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
        </material>
      </visual>
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:gazebo_wheel_props link_name="front_left_wheel_link" />
  <xacro:gazebo_wheel_props link_name="front_right_wheel_link" />
  <xacro:gazebo_wheel_props link_name="rear_left_wheel_link" />
  <xacro:gazebo_wheel_props link_name="rear_right_wheel_link" />

  <!-- chassis body material -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.95 0.45 0.05 1.0</ambient>
        <diffuse>0.95 0.45 0.05 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

</robot>
